<?xml version="1.0" encoding="utf-8"?>
<!-- Translucent dark background for the floating alignment-instructions
     chip. Dark enough to keep cyan text readable over a photograph,
     transparent enough not to hide the area the operator is sighting. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <solid android:color="#CC0F1314" />
    <stroke android:width="1dp" android:color="@color/outline" />
    <corners android:radius="8dp" />
</shape>
