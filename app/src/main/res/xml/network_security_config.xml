<?xml version="1.0" encoding="utf-8"?>
<network-security-config>
    <!-- Cleartext HTTP is rejected by default on Android 9+. PixelSentinel
         desktops typically run on the same LAN as the operator's phone and
         use plain HTTP with token auth + loopback bypass; allowing
         cleartext only to private RFC1918 ranges + link-local + loopback
         keeps that workflow possible without weakening anything else. -->
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="false">localhost</domain>
        <!-- 10.0.0.0/8 -->
        <domain-prefix>10.</domain-prefix>
        <!-- 192.168.0.0/16 -->
        <domain-prefix>192.168.</domain-prefix>
        <!-- 172.16.0.0/12 — enumerated precisely so we don't leak cleartext
             to 172.0-15.* or 172.32-255.* (which are not private). -->
        <domain-prefix>172.16.</domain-prefix>
        <domain-prefix>172.17.</domain-prefix>
        <domain-prefix>172.18.</domain-prefix>
        <domain-prefix>172.19.</domain-prefix>
        <domain-prefix>172.20.</domain-prefix>
        <domain-prefix>172.21.</domain-prefix>
        <domain-prefix>172.22.</domain-prefix>
        <domain-prefix>172.23.</domain-prefix>
        <domain-prefix>172.24.</domain-prefix>
        <domain-prefix>172.25.</domain-prefix>
        <domain-prefix>172.26.</domain-prefix>
        <domain-prefix>172.27.</domain-prefix>
        <domain-prefix>172.28.</domain-prefix>
        <domain-prefix>172.29.</domain-prefix>
        <domain-prefix>172.30.</domain-prefix>
        <domain-prefix>172.31.</domain-prefix>
        <!-- Link-local 169.254.0.0/16 -->
        <domain-prefix>169.254.</domain-prefix>
    </domain-config>
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
